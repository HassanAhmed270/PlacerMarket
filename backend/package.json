{
  "name": "poshaak-backend",
  "version": "0.1.0",
  "description": "Poshaak marketplace backend - plain Express + pg scaffold, JS (no TypeScript)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "worker": "node --env-file-if-exists=.env worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config test/integration/jest.config.js",
    "password:benchmark": "node scripts/benchmark-argon2.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "prepare": "node hooks/install.js",
    "hooks:install": "node hooks/install.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:migrate:baseline": "node --env-file-if-exists=.env db/migrate.js --baseline-existing",
    "db:generate-schema": "node db/generate-schema-snapshot.js",
    "db:check-schema": "node db/generate-schema-snapshot.js --check",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "keys:rotate": "node --env-file-if-exists=.env scripts/rotate-payout-keys.js",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo-seed.js",
    "demo:smoke": "node --env-file-if-exists=.demo.env scripts/demo-smoke.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "^5.3.0",
    "helmet": "8.3.0",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.12.0",
    "pg-boss": "12.38.0",
    "redis": "6.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
