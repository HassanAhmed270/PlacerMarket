{
  "name": "poshaak-backend",
  "version": "0.1.0",
  "description": "Poshaak marketplace backend - plain Express + pg scaffold, JS (no TypeScript)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "prepare": "node hooks/install.js",
    "hooks:install": "node hooks/install.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
