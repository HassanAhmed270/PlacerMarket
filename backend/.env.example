# Copy this file to .env and fill in real values. Nothing reads .env
# automatically yet (no dotenv wired into app.js/server.js) — either add
# `require('dotenv').config()` at the top of src/server.js, or export these
# in your shell/deploy environment directly.

# Postgres connection string. db.service.js is the only file that reads this.
DATABASE_URL=postgres://user:password@localhost:5432/poshaak
# Optional worker-only direct PostgreSQL URL when DATABASE_URL uses a transaction pooler.
QUEUE_DATABASE_URL=postgres://user:password@localhost:5432/poshaak
# Redis connection used by both the web and worker processes (FR-77).
REDIS_URL=redis://localhost:6379
# Disposable PostgreSQL database for `npm run test:integration`.
# The database name must contain "test"; integration setup drops/recreates public.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/poshaak_test
# Optional; only set to 1 for an explicitly approved remote disposable test DB.
TEST_DATABASE_ALLOW_REMOTE=0

# Bounded web-process PostgreSQL pool and fast-fail timeouts (FR-79c).
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=1000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=1000

# Port the Express server listens on (src/server.js). Defaults to 3000 if unset.
PORT=3000

# Base URL used to build share links (discovery.service.buildShareUrl, FR-27).
# No trailing slash.
PUBLIC_BASE_URL=http://localhost:5173

# NOT YET USED: session/auth secret. users.service.authenticate() is an
# unimplemented stub (see agent.md "Known gaps") — the session strategy
# (cookie session vs JWT) hasn't been decided, so there's nothing here to
# configure yet. Add the relevant secret env var once that's picked.
