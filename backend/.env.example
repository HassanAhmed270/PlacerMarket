# Copy this file to .env and fill in real values. Nothing reads .env
# automatically yet (no dotenv wired into app.js/server.js) — either add
# `require('dotenv').config()` at the top of src/server.js, or export these
# in your shell/deploy environment directly.

# Postgres connection string. db.service.js is the only file that reads this.
DATABASE_URL=postgres://user:password@localhost:5432/poshaak

# Port the Express server listens on (src/server.js). Defaults to 3000 if unset.
PORT=3000

# Base URL used to build share links (discovery.service.buildShareUrl, FR-27).
# No trailing slash.
PUBLIC_BASE_URL=http://localhost:5173

# NOT YET USED: session/auth secret. users.service.authenticate() is an
# unimplemented stub (see agent.md "Known gaps") — the session strategy
# (cookie session vs JWT) hasn't been decided, so there's nothing here to
# configure yet. Add the relevant secret env var once that's picked.
