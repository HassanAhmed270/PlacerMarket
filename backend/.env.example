# Copy this file to .env and fill in real values. The start, dev, worker,
# migration, and seed npm scripts load it with Node's --env-file-if-exists.
# Existing shell/deployment environment variables take precedence.

# Postgres connection string. db.service.js is the only file that reads this.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/CHANGE_ME
# Redis connection used by both the web and worker processes (FR-77).
REDIS_URL=redis://CHANGE_ME:6379
# Owner-approved disposable PostgreSQL target for `npm run test:integration`.
# Integration setup drops/recreates schemas only after host/name/identity guards pass.
TEST_DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/testing_only
# Optional; only set to 1 for an explicitly approved remote disposable test DB.
TEST_DATABASE_ALLOW_REMOTE=0

# Bounded web-process PostgreSQL pool and fast-fail timeouts (FR-79c).
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=1000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=1000

# Port the Express server listens on (src/server.js). Defaults to 3000 if unset.
PORT=3000

# Base URL used to build share links (discovery.service.buildShareUrl, FR-27).
# No trailing slash.
PUBLIC_BASE_URL=http://localhost:5173

# JWT access-token settings (SEC-02, FR-84). Set a unique random secret of at
# least 32 bytes outside this example file before starting the web server.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900

# Comma-separated exact frontend origins; no wildcard or paths (SEC-22).
CORS_ORIGINS=http://localhost:5173

# FR-83d: all code limits are configurable; approved defaults are shown.
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_MAX_ATTEMPTS=3
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_ADDRESS_HOURLY_MAX=5
EMAIL_CODE_ADDRESS_DAILY_MAX=10
EMAIL_CODE_IP_SOFT_HOURLY_SIGNAL=30
EMAIL_CODE_FAILURES_HOURLY_LOCK=10
EMAIL_CODE_LOCK_SECONDS=900

# FR-84b: local benchmark selected 65536 KiB / t=3 / p=1; remeasure on production hosts.
PASSWORD_HASH_MAX_CONCURRENCY=4
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# FR-84b provisional rate-limit defaults; tune and document before launch.
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_SIGNUP_IP_MAX=5
RATE_LIMIT_SIGNUP_ACCOUNT_MAX=3
RATE_LIMIT_RESET_IP_MAX=10
RATE_LIMIT_RESET_ACCOUNT_MAX=5
RATE_LIMIT_OFFER_IP_MAX=60
RATE_LIMIT_OFFER_ACCOUNT_MAX=30
RATE_LIMIT_MESSAGE_IP_MAX=120
RATE_LIMIT_MESSAGE_ACCOUNT_MAX=60

# Fakes never enable implicitly and are always forbidden in production.
EMAIL_SENDER_ADAPTER=
CHALLENGE_VERIFIER_ADAPTER=
ALLOW_FAKE_ADAPTERS=false
# Set these only in the deployment secret store when live providers are chosen.
EMAIL_PROVIDER_API_KEY=CHANGE_ME
CHALLENGE_PROVIDER_KEY=CHANGE_ME
